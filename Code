<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Joanne Tadeo - Graphic Designer & Visual Creator</title>
    <style>
        /* Reset and base styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b091a;
            color: #ffffff;
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: rgba(11, 9, 26, 0.9);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: #e2b4ff;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-links a:hover {
            color: #c084fc;
        }

        /* Hero Section */
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            background: linear-gradient(180deg, #161233 0%, #0b091a 100%);
        }

        .hero h1 {
            font-size: 3rem;
            color: #f3e8ff;
            margin-bottom: 10px;
        }

        .hero h2 {
            font-size: 1.5rem;
            color: #c084fc;
            margin-bottom: 20px;
            font-weight: 400;
        }

        .hero p {
            max-width: 600px;
            color: #cbd5e1;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 12px 28px;
            background: linear-gradient(90deg, #8b5cf6, #ec4899);
            color: white;
            border-radius: 25px;
            font-weight: bold;
            transition: opacity 0.3s ease;
        }

        .btn:hover {
            opacity: 0.9;
        }

        /* Content Sections */
        section {
            padding: 80px 8%;
        }

        .section-title {
            font-size: 2rem;
            margin-bottom: 40px;
            color: #e2b4ff;
            text-align: center;
        }

        /* About Section */
        .about-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
            background: #13102b;
            padding: 40px;
            border-radius: 16px;
        }

        .about-text p {
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        /* Skills & Tools Section */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .skill-card {
            background: #161233;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #2e285c;
        }

        .skill-card h3 {
            color: #c084fc;
            margin-bottom: 15px;
        }

        .skill-card ul {
            list-style: none;
            color: #cbd5e1;
        }

        .skill-card li {
            margin-bottom: 8px;
        }

        /* Services Section */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
        }

        .service-box {
            background: #161233;
            padding: 30px 20px;
            text-align: center;
            border-radius: 12px;
            border: 1px solid #2e285c;
            color: #f3e8ff;
        }

        /* Featured Work Section */
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .portfolio-item {
            background: #161233;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2e285c;
        }

        .portfolio-img {
            width: 100%;
            height: 200px;
            background-color: #2e285c;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8b5cf6;
        }

        .portfolio-info {
            padding: 20px;
        }

        .portfolio-info h3 {
            color: #f3e8ff;
            font-size: 1.1rem;
        }

        .portfolio-info p {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        /* Testimonials */
        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .testimonial-card {
            background: #13102b;
            padding: 25px;
            border-radius: 12px;
            border-left: 4px solid #c084fc;
        }

        .testimonial-card p {
            color: #cbd5e1;
            font-style: italic;
            margin-bottom: 15px;
        }

        .testimonial-card span {
            color: #8b5cf6;
            font-size: 0.85rem;
            font-weight: bold;
        }

        /* Contact & Footer */
        .contact {
            text-align: center;
            background: #13102b;
            border-radius: 16px;
            margin: 0 8% 80px 8%;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #64748b;
            font-size: 0.85rem;
            border-top: 1px solid #161233;
        }
    </style>
</head>
